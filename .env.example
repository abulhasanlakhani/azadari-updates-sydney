# Azure Function — upstream API URL
# Add this as an Application Setting in Azure Static Web Apps portal
# (Settings → Configuration → Application settings)
MAJALIS_API_URL=https://d3ma4bqipgu84o.cloudfront.net/api/majalis

# Supabase project — Settings → API in the Supabase dashboard.
# The anon key is safe to expose to the browser; access is controlled by
# Row Level Security and column-level grants (see supabase/migrations/).
# For production these must be present at BUILD time (GitHub Actions secrets).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/import-legacy-majalis.mjs (run locally, never committed
# or exposed to the client).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
